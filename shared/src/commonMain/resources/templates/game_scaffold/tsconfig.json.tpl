{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "rootDir": "./game/src",
    "ignoreDeprecations": "6.0"
  },
  "include": ["game/src/**/*"]
}
