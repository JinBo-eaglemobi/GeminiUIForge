{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "servers": {
      "gemini-ui-forge": {
        "type": "remote",
        "url": "http://127.0.0.1:18330/mcp"
      },
      "compose-hot-reload": {
        "type": "local",
        "command": [
          "pwsh",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/hot-mcp-launcher.ps1"
        ]
      }
    }
  }
}