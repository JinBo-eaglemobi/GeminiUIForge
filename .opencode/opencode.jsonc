{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "gemini-ui-forge": {
      "type": "remote",
      "url": "http://127.0.0.1:18330/mcp",
      "enabled": true
    },
    "compose-hot-reload": {
      "type": "local",
      "enabled": true,
      "command": [
        "cmd.exe",
        "/c",
        "gradlew.bat",
        "--no-daemon",
        "--quiet",
        "--console=plain",
        ":desktopApp:hotMcpServer"
      ]
    }
  }
}