# 1. 自动探测文本与二进制文件，常规文本默认归一化
* text=auto

# 2. 明确常用文本文件策略
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gitignore text eol=lf

# 3. 严禁对任何二进制文件做换行符篡改
*.jar binary
*.war binary
*.zip binary
*.class binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# 4. Linux 脚本强制保持 LF
gradlew text eol=lf
*.sh text eol=lf

# 5. Windows 专有脚本
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
